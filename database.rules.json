{
  "rules": {
    "sessions": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["startTime", "owner"]
    },
    "entries": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["sessionId", "timestamp", "owner"]
    },
    "routes": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["city", "createdAt"]
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
